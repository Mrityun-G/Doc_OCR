          {"key": "zip", "label": "ZIP", "aliases": ["zip code", "zipcode", "postal code", "zip postal code"], "type": "zip", "acroform": "pat_zip", "w": 0.35},
          {"key": "email", "label": "Email", "aliases": ["e mail", "email address", "e mail address"], "type": "email", "acroform": "pat_email", "w": 1.0}
        ]
      }

{
  "template_id": "patient_intake_v1",
  "document_type": "patient_intake",
  "title": "Patient Intake Form",
  "reference_pdf": "reference_template.pdf",
  "note": "STAND-IN reference template. Replace section/field labels, aliases and acroform names with those of the real reference PDF (see README: 'Adapting to the real reference PDF').",

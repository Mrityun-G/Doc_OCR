    "PRESCRIBED_BY":                {"subject": ["medication"], "object": ["doctor"]},
    "HAS_ALLERGY":                  {"subject": ["patient"], "object": ["allergy"]},
    "HAS_CONDITION":                {"subject": ["patient", "family_member"], "object": ["medical_condition"]},
    "HAD_SURGERY":                  {"subject": ["patient"], "object": ["surgery"]},
    "PERFORMED_AT":                 {"subject": ["surgery"], "object": ["hospital"]},
    "HAS_FAMILY_HISTORY":           {"subject": ["patient"], "object": ["family_member"]},
    "PROVIDES_CONSENT":             {"subject": ["patient"], "object": ["consent"]},
    "AUTHORIZES_COMMUNICATION":     {"subject": ["consent"], "object": ["@literal"]},
    "DECLINES_COMMUNICATION":       {"subject": ["consent"], "object": ["@literal"]},
    "AUTHORIZES_DISCLOSURE_TO":     {"subject": ["consent"], "object": ["authorized_family_member"]},
    "HAS_AUTHORIZED_FAMILY_MEMBER": {"subject": ["patient"], "object": ["authorized_family_member"]},
    "SIGNATURE_FOR":                {"subject": ["signature"], "object": ["agreement"]},
    "SIGNS":                        {"subject": ["patient"], "object": ["agreement"]}
  },

  "sections": [
